# Portfolio frontend build-time config.
# Copy to .env.local for local dev. In CI these are set as GitHub repo vars/secrets
# (see .github/workflows/deploy-web.yml) because NEXT_PUBLIC_* are baked in at build.

# Deployed backend URLs.
# Local dev defaults if unset: gift -> http://localhost:8000/api, site-risk -> http://localhost:8002
NEXT_PUBLIC_GIFT_APP_API=https://gift-api.<your-container-app-domain>/api
NEXT_PUBLIC_SITE_RISK_API=https://site-risk-api.<your-container-app-domain>

# Azure Application Insights (optional).
# Azure portal: Application Insights resource -> Overview -> "Connection String".
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=
