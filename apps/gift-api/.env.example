# Environment: "development" (default) or "production"
ENVIRONMENT=development

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Leave AZURE_OPENAI_API_KEY UNSET in production to use Managed Identity (Entra ID).
AZURE_OPENAI_API_KEY=<your-key-for-local-dev-only>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
# Leave AZURE_SEARCH_API_KEY UNSET in production to use Managed Identity (Entra ID).
AZURE_SEARCH_API_KEY=<your-key-for-local-dev-only>
AZURE_SEARCH_INDEX_NAME=mallory-items

# Raindrop.io (only needed where /sync runs — keep secret; set in App Settings in prod)
RAINDROP_TOKEN=<your-raindrop-token>

# CORS origin
FRONTEND_ORIGIN=http://localhost:5173

# --- Abuse / cost controls ---------------------------------------------------
# Required to call /sync and /generate in production.
ADMIN_TOKEN=<random-long-string>
# Chat usage caps per UTC day.
CHAT_LIMIT_PER_IP_PER_DAY=5
CHAT_LIMIT_GLOBAL_PER_DAY=200
