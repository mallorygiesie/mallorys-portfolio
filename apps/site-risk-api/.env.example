# Environment
ENVIRONMENT=development

# Azure OpenAI — same resource as the gift app
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key-for-local-dev>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# NASA FIRMS — free key: firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=<your-firms-key>

# EPA AirNow — free key: airnowapi.org/account/create/
AIRNOW_API_KEY=<your-airnow-key>

# NOAA NWS and FEMA/NIFC need no keys — they're open APIs

FRONTEND_ORIGIN=http://localhost:5173
